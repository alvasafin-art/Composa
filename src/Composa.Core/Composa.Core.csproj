<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Composa</RootNamespace>
    <UseDirectML Condition="$(RuntimeIdentifier.StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">true</UseDirectML>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" Condition="'$(UseDirectML)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="'$(UseDirectML)' == 'true'" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="build" Condition="'$(UseDirectML)' == 'true'" />
    <Content Include="Models/efficient_sam_vits_*.onnx" Link="models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Models/vitmatte_small.onnx" Link="models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Models/*.onnx" Exclude="Models/efficient_sam_vits_*.onnx;Models/vitmatte_small.onnx" Link="models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="../../packaging/model-licenses/*" Link="model-licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Composa.Core.Tests" />
    <EmbeddedResource Include="IO/Psd/sRGB2014.icc" />
    <Content Include="IO/Psd/sRGB2014-LICENSE.txt" Link="sRGB2014-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UseDirectML)' == 'true'">
    <DirectMLRid>$(RuntimeIdentifier)</DirectMLRid>
    <DirectMLRid Condition="'$(DirectMLRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</DirectMLRid>
    <DirectMLArch Condition="'$(DirectMLRid)' == 'win-arm64'">arm64</DirectMLArch>
    <DirectMLArch Condition="'$(DirectMLRid)' == 'win-x64'">x64</DirectMLArch>
  </PropertyGroup>
  <ItemGroup Condition="'$(DirectMLArch)' != ''">
    <Content Include="$(PkgMicrosoft_AI_DirectML)/bin/$(DirectMLArch)-win/DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_AI_DirectML)/LICENSE.txt" Link="DirectML-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_AI_DirectML)/ThirdPartyNotices.txt" Link="DirectML-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
